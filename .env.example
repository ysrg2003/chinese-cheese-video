# Default production language: en. Supported values are en and zh only.
VIDEO_LANGUAGE=en
LOCAL_DB_PATH=data/chinese_cheese_video.db
STORAGE_BACKEND=local

# Optional remote backend; local SQLite remains the fallback when unavailable.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Optional director providers.
# Reusable external AI Router project.
AI_ROUTER_PATH=../ai-provider-router
AI_ROUTER_CONFIG_DIR=../ai-provider-router/config
AI_ROUTER_STATE_DB=data/ai_router.db
AI_ROUTER_GEMINI_KEYS_JSON=[]
AI_ROUTER_HF_KEYS_JSON=[]
HF_TOKEN=
AI_ROUTER_CHAIN=default
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2
USE_WORD_CAPTIONS=0
# Male voices by default; override only with another verified male Edge-TTS voice.
TTS_VOICE_EN=en-US-GuyNeural
TTS_VOICE_ZH=zh-CN-YunjianNeural
# Unattended content runner
DAILY_CONTENT_COUNT=1
AUTOMATION_LANGUAGES=en,zh
DISCOVERY_LIMIT=20
DISCOVERY_RSS_QUERY=xiangqi OR "Chinese chess" OR 象棋
DISCOVERY_RSS_FEEDS=
YOUTUBE_API_KEY=
YOUTUBE_SEARCH_QUERY=xiangqi Chinese chess
YOUTUBE_LOOKBACK_DAYS=7
# YouTube publishing: keep disabled until OAuth has been configured; enabled videos publish publicly.
YOUTUBE_OAUTH_TOKEN_JSON=
YOUTUBE_PUBLISH_ENABLED=0
YOUTUBE_PUBLISH_MODE=public
YOUTUBE_AUTO_CREATE_PLAYLISTS=1
